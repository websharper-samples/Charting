<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Charting</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Client.fs" />
    <Compile Include="Startup.fs" />
    <None Include="package.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="wsconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WebSharper" Version="10.1.9.686" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.9.686" />
    <PackageReference Include="WebSharper.UI" Version="10.1.7.686" />
    <PackageReference Include="WebSharper.AspNetCore" Version="10.1.9.686" />
    <PackageReference Include="WebSharper.Charting" Version="10.1.0.667" />
    <PackageReference Include="WebSharper.ChartJs" Version="10.1.0.667" />
    <!-- WebSharper.Charting pulls in Plotly; pin it so NuGet doesn't resolve
         an older build with an incompatible metadata format. -->
    <PackageReference Include="WebSharper.Plotly" Version="10.1.0.667" />
  </ItemGroup>

  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile" Condition=" '$(Configuration)' == 'Release' ">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>

</Project>
